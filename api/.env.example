# ── Rovique API — local environment ─────────────────────────────
# Copy to `.env` and fill in. Real secrets live in `.env`, which is gitignored.
#
# NOTE: every value below is a Rovique placeholder. The credentials belonging
# to the projects this was forked from were removed deliberately, so nothing
# here can write to another brand's store.

NODE_ENV=development
PORT=5002

DEV_MODE=true
# Fixed customer login code, used only while DEV_MODE=true and NODE_ENV is not
# production. With SMTP unset the API returns it in the response instead of
# mailing it, so login can be tested before a mailbox exists.
DEV_OTP=1234

# ── Public URLs (used to build links inside emails) ──────────────
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Database (Postgres) ──────────────────────────────────────────
# DATABASE_URL is the pooled connection the running app uses.
# DIRECT_URL is the session connection Prisma needs for migrations.
#
# On Supabase the direct host `db.<ref>.supabase.co` is IPv6-only and may be
# unreachable from your network. If so, point BOTH at the IPv4 pooler:
#   DATABASE_URL → transaction pooler :6543 with ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   → session pooler :5432
DATABASE_URL=""
DIRECT_URL=""

# ── Auth (own JWT + bcrypt — no third-party auth provider) ───────
# Generate a fresh secret, e.g. `openssl rand -hex 32`
JWT_SECRET=""
JWT_EXPIRES_IN=7d

# The initial admin account created by `npm run seed`.
ADMIN_EMAIL=admin@rovique.local
ADMIN_PASSWORD=""

# ── CORS ─────────────────────────────────────────────────────────
# 3000 = storefront (dev), 3001 = admin, 3040 = storefront `next start`.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3040

# ── Payments (Razorpay) ──────────────────────────────────────────
# Rovique's own Razorpay account. rzp_test_ prefix = test mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Email (SMTP) ─────────────────────────────────────────────────
# Rovique's own sending domain, verified with the provider.
# For Resend: host smtp.resend.com, port 465, user literally "resend",
# password = the API key.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Fulfilment ───────────────────────────────────────────────────
# There is no courier integration and no keys to set. Orders are packed and
# dispatched by hand; the courier name and docket number are typed into the
# admin panel, which is what the customer sees on "track my order".

# Placeholder testimonials for demos. Leave false: seeded reviews read as real
# customers and must never reach production.
SEED_DEMO_REVIEWS=false

# ── Login codes by SMS (IndiaHost) ──────────────────────────────
# Customers sign in with a code texted to their mobile; there is no email
# login. The code is generated and checked by this API — the gateway only
# carries the message. Credentials come from the IndiaHost dashboard.
# With these set, ALLOW_DEV_OTP must be false or the fixed code is used and
# no SMS is sent at all.
SMS_OTP_USER=
SMS_OTP_KEY=

# Where uploaded files are written and served from. Unset = api/uploads.
# On the Deploy Panel set this to a folder OUTSIDE the repo (e.g. /opt/oldspice-uploads):
# every deploy git-cleans the repo and would delete uploads kept inside it.
UPLOADS_DIR=
